# Copy into the selected workspace as .env. Shell variables override this file.
# Default local image: dev-toolchain:<VERSION>, or <VERSION>-node when enabled.
# DEV_IMAGE=ghcr.io/your-owner/dev-environment:0.1.0
# NVIM_CONFIG_PATH=/absolute/path/to/nvim
INSTALL_NODE=false
FORWARD_SSH_AGENT=true
# Optional stable namespace. Otherwise derived from workspace name + path hash.
# DEV_PROJECT_NAME=my-project-dev
